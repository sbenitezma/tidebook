{
  "name": "@tidebook/angular",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node -e \"require('node:fs').cpSync('../../libs/ui/public', 'public', { recursive: true })\"",
    "dev": "ng serve",
    "prebuild": "node -e \"require('node:fs').cpSync('../../libs/ui/public', 'public', { recursive: true })\"",
    "build": "ng build",
    "preview": "vite preview --outDir dist/browser",
    "test": "ng test --no-watch",
    "lint": "eslint .",
    "typecheck": "ngc -p tsconfig.app.json"
  },
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@tidebook/core": "*",
    "@tidebook/tokens": "*",
    "@tidebook/ui": "*",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "nx": {
    "name": "angular"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "vite": "^8.3.5"
  }
}
