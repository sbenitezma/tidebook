{
  "name": "@tidebook/source",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "nx dev react",
    "dev:vue": "nx dev vue",
    "storybook": "nx storybook ui",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "check": "nx run-many -t lint typecheck test build build-storybook",
    "e2e": "nx run-many -t e2e",
    "affected": "nx affected -t lint typecheck test build build-storybook e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "nx": "^24.0.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
